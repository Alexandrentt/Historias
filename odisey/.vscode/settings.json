{
  "git.autoRepositoryDetection": "openEditors",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true
  },
  "[markdown]": {
    "editor.cursorSurroundingLines": 17,
    "editor.tabSize": 4,
    "editor.wrappingIndent": "same",
    "editor.quickSuggestions": {
      "comments": false,
      "strings": false,
      "other": false
    }
  },
  "editor.fontSize": 14,
  "foam.openDailyNote": false,
  "foam.edit.lineEndings": "LF",
  "foam.workspace.openOnStartup": false,
  "files.exclude": {
    "**/node_modules": true
  }
}
